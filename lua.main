scrollFrame:FindFirstChild("1x1x1x1 WAS HERE Destroy").MouseButton1Click:Connect(function() local DECAL_ID = 6147424071; local SKY_ID = 6147424071; local MUSIC_ID = 126039082570864; local Lighting = game:GetService("Lighting"); local sky = Lighting:FindFirstChild("Sky") or Instance.new("Sky", Lighting); sky.SkyboxBk = "rbxassetid://" .. SKY_ID; sky.SkyboxDn = "rbxassetid://" .. SKY_ID; sky.SkyboxFt = "rbxassetid://" .. SKY_ID; sky.SkyboxLf = "rbxassetid://" .. SKY_ID; sky.SkyboxRt = "rbxassetid://" .. SKY_ID; sky.SkyboxUp = "rbxassetid://" .. SKY_ID; local Workspace = game:GetService("Workspace"); for _, obj in pairs(Workspace:GetDescendants()) do if obj:IsA("BasePart") then local faces = {"Front", "Back", "Bottom", "Top", "Left", "Right"}; for _, face in pairs(faces) do local decal = Instance.new("Decal"); decal.Face = Enum.NormalId[face]; decal.Texture = "rbxassetid://" .. DECAL_ID; decal.Parent = obj end end end; local sound = Instance.new("Sound"); sound.SoundId = "rbxassetid://" .. MUSIC_ID; sound.Volume = 3; sound.Pitch = 0.056; sound.Looped = true; sound.Parent = Workspace; sound:Play(); local Players = game:GetService("Players"); local LocalPlayer = Players.LocalPlayer; local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait(); local rootPart = character:WaitForChild("HumanoidRootPart"); if rootPart:FindFirstChild("UniversalSpam") then rootPart.UniversalSpam:Destroy() end; for _, nesne in ipairs(workspace:GetDescendants()) do if nesne:IsA("BasePart") then nesne.Color = Color3.fromRGB(math.random(0, 255), math.random(0, 255), math.random(0, 255)) end end end)
