local function createButton(name)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Text = name
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 15
	btn.Font = Enum.Font.SourceSans
	btn.TextWrapped = true
	btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	btn.BorderColor3 = Color3.fromRGB(255, 69, 0)
	btn.BorderSizePixel = 2
	btn.Parent = scrollFrame

	btn.MouseButton1Click:Connect(function()
		btn.BackgroundColor3 = Color3.fromRGB(255, 69, 0)
		btn.TextColor3 = Color3.fromRGB(0, 0, 0)
		task.wait(0.1)
		btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)
end

for _, name in ipairs(buttonList) do 
	createButton(name) 
end

scrollFrame:FindFirstChild("Color Spam").MouseButton1Click:Connect(function() for _, nesne in ipairs(workspace:GetDescendants()) do if nesne:IsA("BasePart") then nesne.Color = Color3.fromRGB(math.random(0, 255), math.random(0, 255), math.random(0, 255)) end end end)
scrollFrame:FindFirstChild("Fog Night").MouseButton1Click:Connect(function() game.Lighting.ClockTime = 0; game.Lighting.FogColor = Color3.new(1, 0, 0); game.Lighting.FogEnd = 500; game.Lighting.OutdoorAmbient = Color3.new(1, 0, 0) end)
scrollFrame:FindFirstChild("Ball Rain").MouseButton1Click:Connect(function() local player = game.Players.LocalPlayer; for i = 1, 100 do if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then local b = Instance.new("Part"); b.Shape = Enum.PartType.Ball; b.Size = Vector3.new(70, 70, 70); b.Position = player.Character.HumanoidRootPart.Position + Vector3.new(math.random(-350, 350), 1130, math.random(-350, 350)); b.BrickColor = BrickColor.random(); b.Parent = workspace end; task.wait(0.05) end end)
scrollFrame:FindFirstChild("Particles").MouseButton1Click:Connect(function() for _, v in pairs(Workspace:GetDescendants()) do if v:IsA("BasePart") then local p = Instance.new("ParticleEmitter", v); p.Texture = "rbxassetid://128430398966048"; p.Rate = 50 end end end)
scrollFrame:FindFirstChild("2sp00ks Skybox").MouseButton1Click:Connect(function() local SKY_ID = 128430398966048; local Lighting = game:GetService("Lighting"); local sky = Lighting:FindFirstChild("Sky") or Instance.new("Sky", Lighting); sky.SkyboxBk = "rbxassetid://" .. SKY_ID; sky.SkyboxDn = "rbxassetid://" .. SKY_ID; sky.SkyboxFt = "rbxassetid://" .. SKY_ID; sky.SkyboxLf = "rbxassetid://" .. SKY_ID; sky.SkyboxRt = "rbxassetid://" .. SKY_ID; sky.SkyboxUp = "rbxassetid://" .. SKY_ID end)
scrollFrame:FindFirstChild("Spins Skybox").MouseButton1Click:Connect(function() local Lighting = game:GetService("Lighting"); local sky = Lighting:FindFirstChildOfClass("Sky"); if not sky then sky = Instance.new("Sky"); sky.Parent = Lighting end; local rotationSpeed = 50; local currentAngle = 0; while true do local dt = task.wait(); currentAngle = (currentAngle + rotationSpeed * dt) % 360; sky.SkyboxOrientation = Vector3.new(0, currentAngle, 0) end end)
scrollFrame:FindFirstChild("c00lkidd discoleta").MouseButton1Click:Connect(function() while true do game.Lighting.FogColor = Color3.fromRGB(math.random(0, 255), math.random(0, 255), math.random(0, 255)); game.Lighting.FogEnd = math.random(80, 500); task.wait(0.5) end end)
scrollFrame:FindFirstChild("Smooth Disco").MouseButton1Click:Connect(function() local Lighting = game:GetService("Lighting"); local ColorCorrection = Instance.new("ColorCorrectionEffect", Lighting); function zigzag(X) return math.acos(math.cos(X*math.pi))/math.pi end; local Counter = 0; while wait(0.1) do ColorCorrection.TintColor = Color3.fromHSV(zigzag(Counter), 1, 1); Lighting.Ambient = Color3.fromHSV(zigzag(Counter), 1, 1); Counter += 0.01 end end)
scrollFrame:FindFirstChild("Disco").MouseButton1Click:Connect(function() while task.wait(0.5) do game.Lighting.Ambient = Color3.new(math.random(), math.random(), math.random()) end end)
