scrollFrame:FindFirstChild("Sandstorm Effect").MouseButton1Click:Connect(function() local Players = game:GetService("Players"); local TweenService = game:GetService("TweenService"); local player = Players.LocalPlayer; local playerGui = player:WaitForChild("PlayerGui"); local screenGui = Instance.new("ScreenGui"); screenGui.Name = "SandStorm"; screenGui.ResetOnSpawn = false; screenGui.Parent = playerGui; local function onTweenCompleted(sand) sand:Destroy() end; local function CreateSand() local sand = Instance.new("Frame"); sand.Size = UDim2.new(0, math.random(20, 25), 0, math.random(20, 25)); sand.BackgroundColor3 = Color3.fromRGB(230, 190, 110); sand.BackgroundTransparency = math.random(0, 0.5) / 10; sand.BorderSizePixel = 0; sand.Position = UDim2.new(-0.05, 0, math.random(0, 1000) / 1000, 0); sand.Parent = screenGui; local hedefPozisyon = UDim2.new(1.05, 0, sand.Position.Y.Scale + (math.random(-20, 20) / 100), 0); local duration = math.random(1, 2); local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear); local tween = TweenService:Create(sand, tweenInfo, {Position = hedefPozisyon, BackgroundTransparency = 1}); tween:Play(); tween.Completed:Connect(function() onTweenCompleted(sand) end) end; local function startLoop() while true do CreateSand(); task.wait(0.02) end end; task.spawn(startLoop) end)
